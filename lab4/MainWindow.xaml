<Window x:Class="lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab4"
        mc:Ignorable="d"
        Title="Облік медичних препаратів" Height="650" Width="650" Background="#F4F4F6">

    <StackPanel Margin="15">

        <GroupBox Header="Новий препарат" Padding="10" BorderBrush="#A3B1C6">
            <StackPanel>
                <TextBlock Text="Тип препарату:" />
                <ComboBox Name="TypeComboBox" Margin="0,0,0,10">
                    <ComboBoxItem Content="Таблетка" IsSelected="True" />
                    <ComboBoxItem Content="Сироп" />
                    <ComboBoxItem Content="Краплі" />
                </ComboBox>

                <TextBlock Text="Назва ліків:" />
                <TextBox Name="NameInput" Margin="0,0,0,10" Padding="2" />

                <TextBlock Text="Дозування:" />
                <TextBox Name="DosageInput" Margin="0,0,0,10" Padding="2" />

                <TextBlock Text="Ціна (грн):" />
                <TextBox Name="PriceInput" Margin="0,0,0,10" Padding="2" />

                <TextBlock Text="Кількість (шт) / Об'єм (мл):" />
                <TextBox Name="SpecificInput" Margin="0,0,0,10" Padding="2" />

                <Button Name="AddMedicineBtn" Content="Додати препарат" Click="AddMedicineBtn_Click" Background="#B29B9D" Foreground="White" Padding="10,6" Margin="0,10,0,0" BorderThickness="0" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Список препаратів" Padding="10" Margin="0,0,0,10" BorderBrush="#A3B1C6">
            <ListBox Name="MedicineList" Height="100" BorderBrush="#D1D5DB" />
        </GroupBox>

        <GroupBox Header="Аналітика вартості" Padding="10" BorderBrush="#A3B1C6">
            <StackPanel>
                <Button Name="CalcTotalBtn" Content="Порахувати загальну суму" Click="CalcTotalBtn_Click" Background="#B29B9D" Foreground="White" Padding="10,6" Margin="0,0,0,10" BorderThickness="0" />
                <TextBlock Name="TotalCostText" Text="Загальна сума: 0 грн" FontWeight="Bold" Foreground="#4A5568" FontSize="14" />
            </StackPanel>
        </GroupBox>

    </StackPanel>
</Window>